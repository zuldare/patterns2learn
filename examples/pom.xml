<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.9</version>
    <relativePath/>
  </parent>

  <groupId>com.patterns2learn</groupId>
  <artifactId>examples</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>patterns2learn examples</name>

  <properties>
    <java.version>25</java.version>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- EnableDynamicAgentLoading: Mockito attaches its agent at runtime;
                 JDK 21+ warns about that unless it is explicitly allowed.
                 -Xshare:off: no CDS archive for the forked test JVM, which
                 silences "Sharing is only supported for boot loader classes
                 because bootstrap classpath has been appended" when the agent
                 is added to the bootstrap classpath. -->
            <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <modules>
    <module>creational/singleton</module>
    <module>creational/factory-method</module>
    <module>creational/builder</module>
    <module>creational/abstract-factory</module>
    <module>creational/prototype</module>
    <module>structural/proxy</module>
    <module>structural/adapter</module>
    <module>structural/decorator</module>
    <module>structural/facade</module>
    <module>structural/composite</module>
    <module>structural/bridge</module>
    <module>behavioral/template-method</module>
    <module>behavioral/strategy</module>
    <module>behavioral/observer</module>
    <module>behavioral/chain-of-responsibility</module>
    <module>behavioral/command</module>
    <module>behavioral/state</module>
    <module>behavioral/iterator</module>
    <module>behavioral/mediator</module>
    <module>behavioral/visitor</module>
    <module>behavioral/memento</module>
  </modules>
</project>
