---
import { AUTHOR_NAME, GITHUB_URL, LINKEDIN_URL, REPO_URL } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---
<footer class="site-footer">
  <p class="site-footer__credit">
    {t(lang, 'madeBy')} {AUTHOR_NAME} · <a href={REPO_URL} target="_blank" rel="noopener">patterns2learn</a>
  </p>
  <ul class="site-footer__links" role="list" aria-label={t(lang, 'authorLinks')}>
    <li>
      <a class="site-footer__icon" href={LINKEDIN_URL} target="_blank" rel="noopener me" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
        </svg>
      </a>
    </li>
    <li>
      <a class="site-footer__icon" href={GITHUB_URL} target="_blank" rel="noopener me" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57v-2.02c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3z"/>
        </svg>
      </a>
    </li>
  </ul>
</footer>
