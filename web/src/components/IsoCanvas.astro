---
import { renderScene } from '../engine/render';
import type { ResolvedStep, Scene } from '../engine/types';

interface Props {
  scene: Scene;
  steps: ResolvedStep[];
  label: string;
}

const { scene, steps, label } = Astro.props;
// Static HTML points at the first step's description; the player updates it per step.
const describedBy = steps[0] ? ` aria-describedby="describe-${steps[0].id}"` : '';
const svg = renderScene(scene).replace('role="img"', `role="img" aria-label="${label.replace(/"/g, '&quot;')}"${describedBy}`);
---
<figure class="iso-canvas">
  <div class="iso-canvas__stage" set:html={svg} />
  {steps.map((s) => <p id={`describe-${s.id}`} class="sr-only">{s.text.describe}</p>)}
</figure>
