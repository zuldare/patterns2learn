---
import { renderScene } from '../engine/render';
import type { ResolvedStep, Scene } from '../engine/types';

interface Props {
  scene: Scene;
  steps: ResolvedStep[];
  label: string;
}

const { scene, steps, label } = Astro.props;
// Static HTML shows the first step's snapshot and points at its description;
// the player takes over from there.
const first = steps[0];
const svg = renderScene(scene, { step: first, label, describedBy: first ? `describe-${first.id}` : undefined });
---
<figure class="iso-canvas">
  <div class="iso-canvas__stage" set:html={svg} />
  {steps.map((s) => <p id={`describe-${s.id}`} class="sr-only">{s.text.describe}</p>)}
</figure>
