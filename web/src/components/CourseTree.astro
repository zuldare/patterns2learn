---
import type { Category, Lesson } from '../engine/types';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  lessons: Lesson[];
  current?: string;
}

const { lang, lessons, current } = Astro.props;
const order: Category[] = ['spring', 'creational', 'structural', 'behavioral'];
const groups = order
  .map((cat) => ({ cat, items: lessons.filter((l) => l.category === cat) }))
  .filter((g) => g.items.length > 0);
---
<aside class="course-tree" id="course-tree" aria-labelledby="course-tree-title">
  <div class="course-tree__head">
    <h2 id="course-tree-title" class="course-tree__title">{t(lang, 'course')}</h2>
    <button class="btn btn--small course-tree__close" type="button" data-action="toggle-tree" data-js-only>{t(lang, 'close')}</button>
  </div>
  {groups.map(({ cat, items }) => (
    <section class="course-tree__group">
      <h3 class="course-tree__cat">{t(lang, cat)}</h3>
      <ul role="list">
        {items.map((l) => (
          <li>
            <a
              class="course-tree__item"
              href={`/${lang}/patterns/${l.slug}/`}
              aria-current={l.slug === current ? 'page' : undefined}
              data-lesson-link={l.slug}
            >
              <span class="course-tree__name">{l.texts[lang].title}</span>
              <span class="course-tree__done" data-done-mark hidden>
                <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 4.8"/></svg>
                <span class="sr-only">{t(lang, 'completed')}</span>
              </span>
              <span class="course-tree__meta">{l.texts[lang].minutes} {t(lang, 'minutes')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</aside>
