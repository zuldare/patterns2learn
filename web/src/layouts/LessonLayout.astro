---
import '../styles/lesson.css';
import BaseLayout from './BaseLayout.astro';
import CodePanel from '../components/CodePanel.astro';
import CourseTree from '../components/CourseTree.astro';
import IsoCanvas from '../components/IsoCanvas.astro';
import StepBar from '../components/StepBar.astro';
import StepPanel from '../components/StepPanel.astro';
import type { Lesson } from '../engine/types';
import { resolveSteps } from '../lib/lessons';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
  lesson: Lesson;
  lessons: Lesson[];
}

const { lang, lesson, lessons } = Astro.props;
const text = lesson.texts[lang];
const steps = resolveSteps(lesson, lang);
const ids = steps.map((s) => s.id);

// Progressive enhancement: without JS every step is shown in order. Once the
// player sets data-step on the article, only the current step stays visible.
const stepCss = ids
  .map((id) => `[data-lesson][data-step]:not([data-step="${id}"]) [data-step-id="${id}"]{display:none}`)
  .join('\n');
// `<` is escaped so the JSON can never close the script element.
const sceneJson = JSON.stringify(lesson.scene).replace(/</g, '\\u003c');
---
<BaseLayout lang={lang} title={`${text.title} — patterns2learn`} description={text.summary} path={`/patterns/${lesson.slug}/`} hasTree>
  <Fragment slot="head" set:html={`<style>${stepCss}</style>`} />
  <div class="lesson-shell">
    <CourseTree lang={lang} lessons={lessons} current={lesson.slug} />
    <article class="lesson" data-lesson={lesson.slug} data-steps={steps.length} tabindex="0" aria-labelledby="lesson-title">
      <header class="lesson__head">
        <h1 class="lesson__title" id="lesson-title">{text.title}</h1>
        <p class="lesson__summary">{text.summary}</p>
      </header>
      <IsoCanvas scene={lesson.scene} steps={steps} label={text.title} />
      <StepBar lang={lang} steps={steps} />
      <StepPanel lang={lang} steps={steps} />
      <CodePanel lang={lang} steps={steps} />
      <script type="application/json" data-lesson-scene set:html={sceneJson} />
    </article>
  </div>
</BaseLayout>

<script>
  import '../scripts/lesson';
</script>
