---
import '../../styles/lesson.css';
import '../../styles/home.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseTree from '../../components/CourseTree.astro';
import DoneMark from '../../components/DoneMark.astro';
import { listLessons } from '../../lib/lessons';
import { locales, t, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const lessons = await listLessons();
const bySlug = new Map(lessons.map((l) => [l.slug, l]));

// Recommended order (spec §5.1): what Spring already uses first, then what you implement.
const path = [
  { slug: 'singleton', name: 'Singleton' },
  { slug: 'proxy', name: 'Proxy' },
  { slug: 'template-method', name: 'Template Method' },
  { slug: 'strategy', name: 'Strategy' },
  { slug: 'observer', name: 'Observer' },
  { slug: 'decorator', name: 'Decorator' },
  { slug: 'chain-of-responsibility', name: 'Chain of Responsibility' },
  { slug: 'factory-method', name: 'Factory Method' },
].map((p) => ({ ...p, lesson: bySlug.get(p.slug) }));
---
<BaseLayout lang={lang} title={`patterns2learn — ${t(lang, 'tagline')}`} description={t(lang, 'intro')} path="/">
  <div class="home">
    <section class="hero" aria-labelledby="home-title">
      <h1 class="hero__title" id="home-title">patterns<span class="hero__two">2</span>learn</h1>
      <p class="hero__tagline">{t(lang, 'tagline')}</p>
      <p class="hero__intro">{t(lang, 'intro')}</p>
    </section>

    <section class="start-here" aria-labelledby="start-here-title">
      <h2 class="start-here__title" id="start-here-title">{t(lang, 'startHere')}</h2>
      <p class="start-here__intro">{t(lang, 'startHereIntro')}</p>
      <ol class="start-here__list" role="list">
        {path.map(({ name, slug, lesson }) => (
          <li class:list={['start-here__item', { 'is-soon': !lesson }]}>
            {lesson ? (
              <a class="start-here__link" href={`/${lang}/patterns/${slug}/`} data-lesson-link={slug}>
                <span class="start-here__name">{name}</span>
                <span class="start-here__meta">{lesson.texts[lang].minutes} {t(lang, 'minutes')}</span>
                <DoneMark lang={lang} />
              </a>
            ) : (
              <span class="start-here__link">
                <span class="start-here__name">{name}</span>
                <span class="start-here__meta">{t(lang, 'comingSoon')}</span>
              </span>
            )}
          </li>
        ))}
      </ol>
    </section>

    <CourseTree lang={lang} lessons={lessons} static />
  </div>
</BaseLayout>
<script>
  import '../../scripts/tree-progress';
  import '../../scripts/tree-folds';
</script>
