---
/* Living figure gallery (ADR 0001). Not linked from the site, noindex, excluded from the sitemap. */
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../../styles/tokens.css';
import '../../styles/base.css';
import '../../styles/engine.css';
import { renderScene } from '../../engine/render';
import { ICON_NAMES } from '../../engine/icons';
import type { Entity, EntityKind, Link, Scene, Tone } from '../../engine/types';
import scene from '../../content/lessons/strategy/scene';

const DEFAULT_STEP = 'extend';
const step = scene.steps.find(st => st.id === DEFAULT_STEP)!;
const sceneSvg = renderScene(scene, { step, label: 'Escena de Strategy' });
const steps = scene.steps.map(st => ({ id: st.id, visible: st.visible, highlight: st.highlight }));

const TONES: Tone[] = ['neutral', 'accent', 'warn', 'danger'];
const at = { x: 0, y: 0, z: 0 };

/** A one-figure scene; sockets and cartridges get the `implements` links their shape needs. */
function single(shape: string, tone: Tone): Scene {
  const e = (id: string, kind: EntityKind, extra: Partial<Entity> = {}): Entity => ({
    id, kind, label: shape, pos: at, size: { w: 1, d: 1, h: 0.6 }, tone, ...extra,
  });
  const ghost = (id: string): Entity => e(id, 'block');
  const impl = (from: string, to: string, id: string): Link => ({ id, from, to, style: 'implements' });
  switch (shape) {
    case 'block': return { entities: [e('x', 'block', { icon: 'gear' })], links: [], steps: [] };
    case 'cartridge': return { entities: [e('x', 'block', { icon: 'calendar' }), ghost('i')], links: [impl('x', 'i', 'l')], steps: [] };
    case 'socket': return { entities: [e('x', 'interface', { size: { w: 1.4, d: 1.4, h: 0.6 } }), ghost('a'), ghost('b'), ghost('c')], links: ['a', 'b', 'c'].map(f => impl(f, 'x', `l-${f}`)), steps: [] };
    case 'voxel': return { entities: [e('x', 'actor', { size: { w: 1.2, d: 1.2, h: 0.5 } })], links: [], steps: [] };
    default: return { entities: [e('x', 'container', { size: { w: 3, d: 2, h: 0.25 } })], links: [], steps: [] };
  }
}
/** Ghost entities (the other ends of the links) share the spot and are hidden by the baked step. */
const figureSvg = (shape: string, tone: Tone): string =>
  renderScene(single(shape, tone), { step: { visible: ['x'], highlight: [] }, label: `${shape} ${tone}` });
const SHAPES = ['block', 'cartridge', 'socket', 'voxel', 'platform'];

const iconSvg = (icon: (typeof ICON_NAMES)[number]): string =>
  renderScene(
    { entities: [{ id: 'x', kind: 'block', label: icon, pos: at, size: { w: 1, d: 1, h: 0.6 }, tone: 'neutral', icon }], links: [], steps: [] },
    { label: icon },
  );
---
<!doctype html>
<html lang="es" data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Laboratorio de figuras · patterns2learn</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = new URLSearchParams(location.search).get('theme') || JSON.parse(localStorage.getItem('p2l:theme')); } catch (e) {}
        if (t !== 'paper' && t !== 'blueprint' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'paper';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <style>
      body { background: var(--bg); color: var(--ink); }
      .lab { max-width: 1200px; margin: 0 auto; padding: 24px 16px 64px; }
      .lab h1 { margin: 0 0 4px; font-size: 1.5rem; }
      .lab p { color: var(--muted); max-width: 70ch; }
      h2 { margin: 40px 0 8px; font-size: 1.15rem; }
      .bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 12px 0; }
      .bar button {
        font: inherit; font-size: .8rem; padding: 4px 10px; border-radius: 999px; cursor: pointer;
        background: var(--surface); color: var(--ink); border: 1.5px solid var(--ink);
      }
      .bar button[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent-strong); box-shadow: var(--pop-shadow); }
      .bar span { color: var(--muted); font-size: .8rem; margin-right: 4px; }
      .card { background: var(--surface); border: 1.5px solid var(--ink); border-radius: var(--radius); padding: 12px; box-shadow: var(--pop-shadow); }
      .stage svg { max-height: 640px; }
      .grid { display: grid; gap: 8px; align-items: center; }
      .grid--figures { grid-template-columns: 6rem repeat(4, minmax(0, 1fr)); }
      .grid--icons { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
      .grid .head { font-weight: 700; font-size: .8rem; }
      .cell { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 4px; min-width: 0; }
      .cell svg { height: 150px; }
      @media (max-width: 700px) { .grid--figures { grid-template-columns: 4.5rem repeat(4, minmax(0, 1fr)); gap: 4px; } .cell svg { height: 90px; } }
    </style>
  </head>
  <body>
    <main class="lab">
      <h1>Laboratorio de figuras</h1>
      <p>Catálogo vivo del motor isométrico (figuras «Taller», ADR 0001): todas las figuras, tonos e iconos, y la escena de Strategy paso a paso. Página de pruebas, sin enlazar desde la web.</p>

      <div class="bar" role="group" aria-label="Tema">
        <span>Tema:</span>
        <button type="button" data-theme-set="paper">Papel</button>
        <button type="button" data-theme-set="blueprint">Blueprint</button>
        <button type="button" data-theme-set="dark">Oscuro</button>
      </div>

      <h2>Escena de Strategy</h2>
      <div class="bar" role="group" aria-label="Paso">
        <span>Paso:</span>
        {steps.map((st, i) => <button type="button" data-step={st.id} aria-pressed={st.id === DEFAULT_STEP ? 'true' : 'false'}>{i + 1}. {st.id}</button>)}
      </div>
      <section class="card"><div class="stage" set:html={sceneSvg} /></section>

      <h2>Figuras × tonos</h2>
      <p>La forma se deriva del tipo y de los enlaces <code>implements</code>: un bloque que implementa una interfaz es un cartucho; la regleta tiene un hueco por implementación.</p>
      <div class="grid grid--figures" data-gallery="figures">
        <div></div>
        {TONES.map(t => <div class="head">{t}</div>)}
        {SHAPES.map(shape => (
          <>
            <div class="head">{shape}</div>
            {TONES.map(t => <div class="cell" set:html={figureSvg(shape, t)} />)}
          </>
        ))}
      </div>

      <h2>Iconos</h2>
      <div class="grid grid--icons" data-gallery="icons">
        {ICON_NAMES.map(icon => <div class="cell" set:html={iconSvg(icon)} />)}
      </div>
    </main>

    <script type="application/json" id="lab-steps" set:html={JSON.stringify(steps)} />
    <script>
      import { itemState } from '../../engine/render';

      const root = document.documentElement;
      const syncThemeButtons = () => {
        for (const b of document.querySelectorAll<HTMLElement>('[data-theme-set]')) {
          b.setAttribute('aria-pressed', String(b.dataset.themeSet === root.dataset.theme));
        }
      };
      for (const b of document.querySelectorAll<HTMLElement>('[data-theme-set]')) {
        b.addEventListener('click', () => {
          root.dataset.theme = b.dataset.themeSet;
          syncThemeButtons();
        });
      }
      syncThemeButtons();

      type LabStep = { id: string; visible: string[]; highlight: string[] };
      const steps: LabStep[] = JSON.parse(document.getElementById('lab-steps')!.textContent ?? '[]');
      for (const b of document.querySelectorAll<HTMLElement>('[data-step]')) {
        b.addEventListener('click', () => {
          const st = steps.find((s) => s.id === b.dataset.step);
          if (!st) return;
          // Same visibility rule as the static render and the lesson player.
          for (const el of document.querySelectorAll<SVGGElement>('.stage [data-id]')) {
            const { hidden, highlighted } = itemState(st, {
              id: el.dataset.id ?? '',
              from: el.dataset.from,
              to: el.dataset.to,
            });
            el.classList.toggle('is-hidden', hidden);
            el.classList.toggle('is-highlighted', highlighted);
          }
          for (const o of document.querySelectorAll('[data-step]')) o.setAttribute('aria-pressed', String(o === b));
        });
      }
    </script>
  </body>
</html>
